{
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    },
    "backend": {
      "root": "backend",
      "framework": "express"
    }
  },
  "rewrites": [
    { "source": "/backend", "destination": "backend" },
    { "source": "/frontend/dist", "destination": "frontend" }
  ]
}
